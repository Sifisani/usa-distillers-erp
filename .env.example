# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Multi-Environment Firebase Configuration (Dev vs. Production Separation)
# ==============================================================================
# Leave these unset in AI Studio Dev to use firebase-applet-config.json
# (distillers-erp-dev). Set all VITE_FIREBASE_* values in your Production
# CI/CD environment (e.g., .env.production) to target distillers-erp-prod.

# Environment label: "development" | "staging" | "production"
VITE_APP_ENV="development"

# Firebase Web App Config for target environment
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firestore Database ID: use "(default)" for standard prod DBs or the named DB ID
VITE_FIREBASE_DATABASE_ID="(default)"
