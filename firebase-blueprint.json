{
  "entities": {
    "jobCard": {
      "title": "Job Card",
      "description": "Maintenance job card record for plant equipment and work orders",
      "type": "object",
      "properties": {
        "jobCardNumber": {
          "type": "string",
          "description": "Unique identifier like JC-ENG-2026-001"
        },
        "department": {
          "type": "string",
          "description": "Specific department or sub-unit"
        },
        "departmentCategory": {
          "type": "string",
          "description": "High-level department category"
        },
        "equipmentName": {
          "type": "string",
          "description": "Name or tag of the equipment serviced"
        },
        "equipmentId": {
          "type": "string",
          "description": "Optional ID of registered equipment asset"
        },
        "priority": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Emergency"],
          "description": "Urgency and priority level"
        },
        "status": {
          "type": "string",
          "enum": ["Draft", "In Progress", "Pending Spares", "Completed", "Cancelled"],
          "description": "Current lifecycle status of the job card"
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of work required or fault diagnosed"
        },
        "assignedTo": {
          "type": "string",
          "description": "Technician or supervisor assigned"
        },
        "targetDate": {
          "type": "string",
          "description": "Target completion date (YYYY-MM-DD)"
        },
        "totalLaborHours": {
          "type": "number",
          "description": "Calculated total hours of labor recorded"
        },
        "createdById": {
          "type": "string",
          "description": "UID of the user who logged this job card"
        },
        "createdByName": {
          "type": "string",
          "description": "Display name or email of the creator"
        },
        "equipmentCode": {
          "type": "string",
          "description": "Linked plant equipment tag code",
          "maxLength": 50
        },
        "electricalFeeder": {
          "type": "string",
          "description": "Electrical SLD feeder panel/breaker designation",
          "maxLength": 150
        },
        "inspectionId": {
          "type": "string",
          "description": "Source electrical inspection document ID if raised from an inspection",
          "maxLength": 128
        },
        "inspectionReference": {
          "type": "string",
          "description": "Inspection serial reference",
          "maxLength": 60
        },
        "workOrderNumber": {
          "type": "string",
          "description": "Red pre-printed physical works requisition slip number",
          "maxLength": 50
        },
        "requisitionType": {
          "type": "string",
          "enum": ["Normal", "Call Out", "Stop Day"],
          "description": "Maintenance requisition urgency classification"
        },
        "costCenter": {
          "type": "string",
          "description": "Plant cost center code",
          "maxLength": 40
        },
        "dangerTagRequired": {
          "type": "boolean",
          "description": "Whether Danger Tag / LOTO isolation is required"
        },
        "dangerTagNumber": {
          "type": "string",
          "description": "Issued LOTO / Danger Tag identifier",
          "maxLength": 50
        },
        "recipientDepartment": {
          "type": "string",
          "description": "Department receiving the maintenance work request",
          "maxLength": 100
        },
        "originatingDepartment": {
          "type": "string",
          "description": "Department raising the work request",
          "maxLength": 100
        },
        "originatedBy": {
          "type": "string",
          "description": "Originator full name",
          "maxLength": 120
        },
        "originatedTime": {
          "type": "string",
          "description": "Time work request originated",
          "maxLength": 30
        },
        "originatedSignature": {
          "type": "string",
          "description": "Originator sign-off string",
          "maxLength": 120
        },
        "physicalSlipLogged": {
          "type": "boolean",
          "description": "Whether backed by a physical triplicate paper slip"
        },
        "requisitionStage": {
          "type": "string",
          "enum": ["Pending Acceptance", "Accepted", "In Progress", "Pending Spares", "Artisan Completed", "HOD Closed"],
          "description": "Multi-stage works requisition approval and handback stage"
        },
        "assignedSupervisor": {
          "type": "string",
          "description": "Accepting maintenance supervisor",
          "maxLength": 120
        },
        "acceptedAt": {
          "type": "string",
          "description": "ISO timestamp when supervisor accepted requisition",
          "maxLength": 40
        },
        "acceptedBy": {
          "type": "string",
          "description": "Supervisor who accepted the requisition",
          "maxLength": 120
        },
        "completedByArtisan": {
          "type": "string",
          "description": "Artisan who executed and handed back the job",
          "maxLength": 120
        },
        "artisanSignature": {
          "type": "string",
          "description": "Artisan handback signature",
          "maxLength": 120
        },
        "artisanHandbackNotes": {
          "type": "string",
          "description": "Artisan completion notes from physical slip",
          "maxLength": 2000
        },
        "completionDate": {
          "type": "string",
          "description": "Completion date (YYYY-MM-DD)",
          "maxLength": 20
        },
        "completionTime": {
          "type": "string",
          "description": "Completion time (HH:mm)",
          "maxLength": 20
        },
        "completionHours": {
          "type": "number",
          "description": "Hours logged on final artisan handback"
        },
        "laborLogs": {
          "type": "array",
          "description": "Bounded labor entries (<= 200)"
        },
        "comments": {
          "type": "array",
          "description": "Bounded activity and audit chatter entries (<= 500)"
        },
        "sparesRequested": {
          "type": "array",
          "description": "Bounded spares requisition line items (<= 100)"
        },
        "shiftHandovers": {
          "type": "array",
          "description": "Bounded continuous shift handover records (<= 100)"
        },
        "hodSignedBy": {
          "type": "string",
          "description": "Engineering Manager / HOD who digitally signed off closure",
          "maxLength": 120
        },
        "hodDigitalSignOff": {
          "type": "object",
          "description": "HOD digital closure attestation object"
        },
        "qcSignedBy": {
          "type": "string",
          "description": "Quality control verifier name",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format",
          "maxLength": 40
        },
        "workflowStage": {
          "type": "string",
          "enum": [
            "SUBMITTED",
            "ACCEPTED",
            "IN_PROGRESS",
            "WAITING_FOR_PARTS",
            "WAITING_FOR_SHUTDOWN",
            "WORK_COMPLETE",
            "CLOSED",
            "CANCELLED"
          ],
          "description": "Canonical 8-stage Phase 1 works requisition workflow stage"
        },
        "holdReason": {
          "type": "string",
          "description": "Deferral or hold reason for WAITING_FOR_PARTS or WAITING_FOR_SHUTDOWN",
          "maxLength": 500
        },
        "statusHistory": {
          "type": "array",
          "description": "Bounded immutable audit trail of stage transitions (<= 200)"
        },
        "parentJobCardId": {
          "type": "string",
          "description": "Parent job card document ID for linked multi-department companion jobs",
          "maxLength": 128
        },
        "parentJobCardNumber": {
          "type": "string",
          "description": "Parent job card display number e.g. JC-ENG-2026-001",
          "maxLength": 50
        },
        "attachments": {
          "type": "array",
          "description": "Bounded compressed work-order photos and documents (<= 4 entries, <= 220 KB each)"
        }
      },
      "required": [
        "jobCardNumber",
        "department",
        "equipmentName",
        "priority",
        "status",
        "description",
        "assignedTo"
      ]
    },
    "equipment": {
      "title": "Equipment Asset",
      "description": "Distillery plant machinery, turbine, boiler, or vehicle asset",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Equipment identification code"
        },
        "name": {
          "type": "string",
          "description": "Equipment asset name"
        },
        "department": {
          "type": "string",
          "description": "Department housing the machinery"
        },
        "location": {
          "type": "string",
          "description": "Physical area or plant bay"
        },
        "status": {
          "type": "string",
          "enum": ["Operational", "Under Maintenance", "Standby", "Decommissioned"],
          "description": "Current operational health status"
        },
        "criticality": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"],
          "description": "Impact of equipment failure on production"
        },
        "lastServiceDate": {
          "type": "string",
          "description": "Last preventive or corrective service date"
        },
        "nextServiceDate": {
          "type": "string",
          "description": "Scheduled next preventive maintenance"
        },
        "activeJobCardsCount": {
          "type": "number",
          "description": "Count of open job cards linked"
        }
      },
      "required": ["code", "name", "department", "status"]
    },
    "userProfile": {
      "title": "User Profile",
      "description": "Staff profile with department and enterprise role",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "Staff work email"
        },
        "displayName": {
          "type": "string",
          "description": "Staff full name"
        },
        "department": {
          "type": "string",
          "description": "Primary department"
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Supervisor", "Technician", "Operator", "Manager", "Storeman"],
          "description": "Role in the ERP hierarchy"
        }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "storesSlip": {
      "title": "Stores Issue Requisition Slip",
      "description": "Physical triplicate book voucher linking withdrawn spares to maintenance job cards",
      "type": "object",
      "properties": {
        "slipNumber": {
          "type": "string",
          "description": "Pre-printed red sequential serial number e.g. 302857"
        },
        "bookType": {
          "type": "string",
          "enum": ["Mechanical", "Electrical", "Boilers", "Instrumentation", "General"],
          "description": "Maintenance team book origin"
        },
        "date": {
          "type": "string",
          "description": "Date of issue (YYYY-MM-DD)"
        },
        "jobCardNumber": {
          "type": "string",
          "description": "Job card number e.g. JC-2026-0042"
        },
        "requestedByArtisan": {
          "type": "string",
          "description": "Artisan who requested and received the items"
        },
        "issuerSignature": {
          "type": "string",
          "description": "Storeman who authorized the withdrawal e.g. Elliot Mhlongo"
        },
        "status": {
          "type": "string",
          "enum": ["Issued", "Pending Verification", "Verified", "Cancelled"],
          "description": "Voucher lifecycle status"
        }
      },
      "required": ["slipNumber", "date", "jobCardNumber", "requestedByArtisan", "issuerSignature"]
    },
    "powerDistributionNode": {
      "title": "Power Distribution Node",
      "description": "Single-Line Diagram electrical component, transformer, busbar, or circuit breaker (C1-C20)",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Component or circuit designation e.g. C4, C8, TX1"
        },
        "name": {
          "type": "string",
          "description": "Display name of switchgear, breaker, transformer, or MCC panel"
        },
        "category": {
          "type": "string",
          "enum": ["SOURCE", "STEP_UP_TX", "METERING_TX", "BUSBAR", "HV_FUSE", "TRANSFORMER", "BREAKER", "CONTROL_CENTRE"],
          "description": "Component classification in the SLD"
        },
        "brand": {
          "type": "string",
          "description": "Switchgear manufacturer brand e.g. Chint, ABB, Eaton Cutler-Hammer"
        },
        "model": {
          "type": "string",
          "description": "Breaker or unit model e.g. NA1-3200, SACE E1B 12"
        },
        "breakerType": {
          "type": "string",
          "enum": ["VCB", "ACB", "MCCB", "MCB", "Fused Switch-Disconnector", "Unrecorded"],
          "description": "Type of circuit breaker"
        },
        "ratedAmps": {
          "type": "number",
          "description": "Rated current size in Amperes"
        },
        "measuredLoadAmps": {
          "type": "number",
          "description": "Measured field load current in Amperes"
        },
        "operatingState": {
          "type": "string",
          "enum": ["CLOSED", "OPEN", "TRIPPED", "DECOMMISSIONED"],
          "description": "Current switching state"
        },
        "sourceNodeIds": {
          "type": "array",
          "description": "Multi-source upstream electrical node IDs"
        },
        "approvedBy": {
          "type": "string",
          "description": "Engineering supervisor/manager who approved topology modification",
          "maxLength": 120
        },
        "approvedAt": {
          "type": "string",
          "description": "ISO approval timestamp",
          "maxLength": 40
        }
      },
      "required": ["code", "name", "category", "operatingState"]
    },
    "powerConnection": {
      "title": "Power Distribution Connection",
      "description": "Explicit directed electrical connection separating switching nodes from topology edges for multi-source and busbar feeds",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique connection document ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceNodeId": {
          "type": "string",
          "description": "Upstream source node ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetNodeId": {
          "type": "string",
          "description": "Downstream target node ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "voltageTier": {
          "type": "string",
          "enum": ["11kV", "6.3kV", "400V", "415V", "420V"],
          "description": "Conductor nominal voltage tier"
        },
        "edgeRole": {
          "type": "string",
          "enum": ["PRIMARY_FEED", "SUB_FEED", "STANDBY_FEED", "INTERLOCK_TIE"],
          "description": "Electrical connection role"
        },
        "label": {
          "type": "string",
          "description": "Conductor / bus tie engineering label",
          "maxLength": 150
        },
        "approvedBy": {
          "type": "string",
          "description": "Authorized electrical engineer approving connection",
          "maxLength": 120
        },
        "approvedAt": {
          "type": "string",
          "description": "ISO timestamp of approval",
          "maxLength": 40
        },
        "createdBy": {
          "type": "string",
          "description": "Author name",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 40
        }
      },
      "required": ["sourceNodeId", "targetNodeId", "voltageTier", "edgeRole"]
    },
    "dailyPlantReport": {
      "title": "Daily Plant Report",
      "description": "Daily distillery operations, water treatment, steam, fermentation, molasses, and tank inventory sheet",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Report document ID e.g. DPR-2026-09-18"
        },
        "reportDate": {
          "type": "string",
          "description": "Report calendar date (YYYY-MM-DD)"
        },
        "reportedBy": {
          "type": "string",
          "description": "Authoring plant supervisor or operator"
        },
        "status": {
          "type": "string",
          "enum": ["Draft", "Submitted", "Verified"],
          "description": "Report verification status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format"
        }
      },
      "required": ["id", "reportDate", "reportedBy", "status"]
    },
    "electricalMeasurement": {
      "title": "Electrical Measurement Record",
      "description": "Immutable append-only historical field or metered electrical measurement record for power distribution nodes and plant motors",
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "description": "Target PowerDistributionNode ID or Equipment ID",
          "maxLength": 128
        },
        "assetKind": {
          "type": "string",
          "enum": ["POWER_NODE", "EQUIPMENT"],
          "description": "Asset registry type"
        },
        "assetCode": {
          "type": "string",
          "description": "Asset tag/code e.g. TX1, C8, EQ-DIST-01",
          "maxLength": 50
        },
        "measurementType": {
          "type": "string",
          "enum": ["CURRENT", "VOLTAGE", "POWER", "POWER_FACTOR", "FREQUENCY", "ENERGY", "COMPREHENSIVE_PANEL"],
          "description": "Electrical measurement category"
        },
        "phase": {
          "type": "string",
          "enum": ["3PH_TOTAL", "3PH_AVG", "L1", "L2", "L3", "L1_L2", "L2_L3", "L3_L1"],
          "description": "Measured phase or 3-phase reference"
        },
        "unit": {
          "type": "string",
          "description": "Primary unit e.g. A, V, kW, kVA, MULTI",
          "maxLength": 30
        },
        "source": {
          "type": "string",
          "enum": ["MEASURED", "METERED"],
          "description": "Field clamp/multimeter measurement or installed meter reading"
        },
        "values": {
          "type": "object",
          "description": "Numeric readings map (currentAmps, currentL1-L3, voltageV, activePowerKw, apparentPowerKva, reactivePowerKvar, powerFactor, frequencyHz, energyKwh)"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 timestamp when measurement was taken",
          "maxLength": 40
        },
        "recordedBy": {
          "type": "string",
          "description": "Display name of recording electrician or engineer",
          "maxLength": 120
        },
        "recordedByUid": {
          "type": "string",
          "description": "Firebase Auth UID of recorder",
          "maxLength": 128
        },
        "notes": {
          "type": "string",
          "description": "Optional field observation notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Server/client creation ISO timestamp",
          "maxLength": 40
        }
      },
      "required": ["assetId", "assetKind", "measurementType", "phase", "unit", "source", "values", "timestamp", "recordedBy", "recordedByUid", "createdAt"]
    },
    "electricalInspection": {
      "title": "Electrical Asset Inspection Record",
      "description": "Immutable append-only structured electrical inspection record linked to plant equipment or SLD nodes",
      "type": "object",
      "properties": {
        "inspectionNumber": { "type": "string", "maxLength": 60 },
        "assetId": { "type": "string", "maxLength": 128 },
        "assetKind": { "type": "string", "enum": ["POWER_NODE", "EQUIPMENT"] },
        "assetCode": { "type": "string", "maxLength": 50 },
        "assetName": { "type": "string", "maxLength": 150 },
        "assetCategory": { "type": "string", "enum": ["CIRCUIT_BREAKER", "TRANSFORMER", "MOTOR", "MCC_DB"] },
        "plantArea": { "type": "string", "maxLength": 120 },
        "electricalFeeder": { "type": "string", "maxLength": 150 },
        "conditionAssessment": {
          "type": "string",
          "enum": ["HEALTHY", "ATTENTION_REQUIRED", "FAULT_DETECTED", "UNDER_MAINTENANCE", "ISOLATED", "DECOMMISSIONED"]
        },
        "operatingStateSnapshot": { "type": "string", "maxLength": 40 },
        "templateId": { "type": "string", "enum": ["CIRCUIT_BREAKER", "TRANSFORMER", "MOTOR", "MCC_DB"] },
        "templateVersion": { "type": "number" },
        "checklistResults": { "type": "array" },
        "observations": { "type": "string", "maxLength": 3000 },
        "photos": { "type": "array" },
        "recommendations": { "type": "string", "maxLength": 2000 },
        "followUpRequired": { "type": "boolean" },
        "followUpAction": { "type": "string", "maxLength": 500 },
        "recommendedPriority": { "type": "string", "enum": ["Low", "Medium", "High", "Emergency"] },
        "technicianId": { "type": "string", "maxLength": 128 },
        "technicianName": { "type": "string", "maxLength": 120 },
        "technicianRole": { "type": "string", "enum": ["Admin", "Manager", "Supervisor", "Technician"] },
        "inspectedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "description": "Server timestamp" },
        "correctsInspectionId": { "type": "string", "maxLength": 128 },
        "amendmentReason": { "type": "string", "maxLength": 500 }
      },
      "required": [
        "inspectionNumber",
        "assetId",
        "assetKind",
        "assetCode",
        "assetName",
        "assetCategory",
        "plantArea",
        "electricalFeeder",
        "conditionAssessment",
        "templateId",
        "templateVersion",
        "checklistResults",
        "observations",
        "photos",
        "recommendations",
        "followUpRequired",
        "technicianId",
        "technicianName",
        "technicianRole",
        "inspectedAt",
        "createdAt"
      ]
    },
    "electricalInspectionReview": {
      "title": "Electrical Inspection Supervisor Review",
      "description": "Immutable supervisor/manager review and approval decision referencing an inspection record",
      "type": "object",
      "properties": {
        "inspectionId": { "type": "string", "maxLength": 128 },
        "assetId": { "type": "string", "maxLength": 128 },
        "decision": { "type": "string", "enum": ["APPROVED", "ACTION_REQUIRED"] },
        "reviewNotes": { "type": "string", "maxLength": 1000 },
        "reviewerUid": { "type": "string", "maxLength": 128 },
        "reviewerName": { "type": "string", "maxLength": 120 },
        "reviewerRole": { "type": "string", "enum": ["Admin", "Manager", "Supervisor"] },
        "reviewedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "description": "Server timestamp" }
      },
      "required": ["inspectionId", "assetId", "decision", "reviewNotes", "reviewerUid", "reviewerName", "reviewerRole", "reviewedAt", "createdAt"]
    },
    "inspectionTemplate": {
      "title": "Configurable Inspection Checklist Template",
      "description": "Admin-managed electrical inspection template by equipment category",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["CIRCUIT_BREAKER", "TRANSFORMER", "MOTOR", "MCC_DB"] },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "version": { "type": "number" },
        "items": { "type": "array" },
        "updatedBy": { "type": "string", "maxLength": 120 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "description": "Server timestamp" }
      },
      "required": ["category", "title", "description", "version", "items", "updatedBy", "updatedByUid", "updatedAt"]
    },
    "orgMasterData": {
      "title": "Plant Organization Master Data Configuration",
      "description": "Manager/Admin configurable plant departments, trades, shifts, and weekly standby roster",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "departments": { "type": "array" },
        "trades": { "type": "array" },
        "shifts": { "type": "array" },
        "standbyRoster": { "type": "array" },
        "version": { "type": "number" },
        "updatedBy": { "type": "string", "maxLength": 120 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "departments", "trades", "shifts", "standbyRoster", "version"]
    },
    "appNotification": {
      "title": "Plant Workflow Notification",
      "description": "Real-time persistent alert for new breakdowns, standby dispatches, workflow stage transitions, and HOD reviews",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "JOB_CARD_CREATED",
            "JOB_CARD_EMERGENCY",
            "JOB_CARD_ASSIGNED",
            "JOB_CARD_HOLD",
            "JOB_CARD_WORK_COMPLETE",
            "JOB_CARD_CLOSED",
            "COMPANION_JOB_CREATED"
          ]
        },
